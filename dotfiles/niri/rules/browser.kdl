// Chromium-based browsers
window-rule {
    match app-id="^(google-)?[cC]hrom(e|ium)$|^[bB]rave-browser$|^[mM]icrosoft-edge$|^[Vv]ivaldi-stable$|^helium$"

    draw-border-with-background false
}

// Firefox-based browsers
window-rule {
    match app-id="^([fF]irefox|zen|librewolf)$"

    block-out-from "screencast"

    opacity 1.0
}

// Video apps
window-rule {
    match app-id="^chrome-youtube\\.com__-Default$|^chrome-app\\.zoom\\.us__wc_home-Default$"

    opacity 1.0
}
