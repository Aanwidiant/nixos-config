# File system
if command -v eza &> /dev/null; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi

alias ff="fzf --preview 'bat --style=numbers --color=always {}'"

if command -v zoxide &> /dev/null; then
  alias cd="zd"
  zd() {
    if [ $# -eq 0 ]; then
      builtin cd ~ && return
    elif [ -d "$1" ]; then
      builtin cd "$1"
    else
      z "$@" && printf "\U000F17A9 " && pwd || echo "Error: Directory not found"
    fi
  }
fi

open() {
  xdg-open "$@" >/dev/null 2>&1 &
}

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Git
# basic
alias g='git'

# status & info
alias gs='git status -sb'
alias gl='git log --oneline --graph --decorate --all'

# add
alias ga='git add'
alias gaa='git add .'

# commit
alias gc='git commit -m'
alias gca='git commit -a -m'
alias gcm='git commit --amend -m'

# branch
alias gb='git branch'
alias gbd='git branch -d'
alias gbr='git branch -r'

# checkout / switch
alias gco='git checkout'
alias gsw='git switch'
alias gswc='git switch -c'

# push & pull
alias gp='git push'
alias gpl='git pull'
alias gpo='git push origin'
alias gpom='git push origin main'
alias gpob='git push origin $(git branch --show-current)'

# stash
alias gst='git stash'
alias gsta='git stash apply'
alias gstd='git stash drop'
alias gstp='git stash pop'

# rebase
alias grb='git rebase'
alias grbi='git rebase -i'
alias grbc='git rebase --continue'
alias grba='git rebase --abort'

# reset 
alias grh='git reset --hard'
alias grs='git reset --soft HEAD~1'

# Lazygit
alias lg='lazygit'

# Lazydocker
alias ld='lazydocker'

# Ollama service shortcuts
alias ollama-start='sudo systemctl start ollama'
alias ollama-stop='sudo systemctl stop ollama'
alias ollama-status='systemctl status ollama'

# Ollama model shortcuts
alias qwen='ollama run qwen3:8b'

# Switch New Generations (switch)
alias nix-switch='sudo nixos-rebuild switch --flake ~/nixos-config#'

# Boot Only (sync)
alias nix-sync='sudo nixos-rebuild boot --flake ~/nixos-config#'

# Update flake inputs
alias nix-update='nix flake update --flake ~/nixos-config'

# Upgrade = Update + Switch
alias nix-upgrade="nix-update && nix-switch"

# List system generations
alias nix-list='sudo nixos-rebuild list-generations'

# Clean Generations Old
alias nix-clean='sudo nix-collect-garbage --delete-old'

# Optimize store (optional)
alias nix-optimize='sudo nix-store --optimize'

# GPU Stats
alias gpu-stats='sudo intel_gpu_top'

# Cliphis wipe
alias cwipe='cliphist wipe'

# LAN - Static IP (Office)
alias connect-office='sudo nmcli con modify "enp0s31f6" \
ipv4.method manual \
ipv4.addresses 10.200.100.159/24 \
ipv4.gateway 10.200.100.1 \
ipv4.dns "8.8.8.8 1.1.1.1" && \
sudo nmcli con up "enp0s31f6"'

# LAN - DHCP
alias connect-home='sudo nmcli con modify "enp0s31f6" ipv4.method auto && sudo nmcli con up "enp0s31f6"'
