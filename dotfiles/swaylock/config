# dotfiles/swaylock/config
ignore-empty-password
show-failed-attempts
daemonize

# Background
image=/home/aanwidiant/.config/theme/current/background
scaling=fill

# Colors — input field
inside-color=00000000
inside-clear-color=00000000
inside-caps-lock-color=00000000
inside-wrong-color=ff000033

ring-color=ffffff22
ring-clear-color=00ff9966
ring-caps-lock-color=ffaa0066
ring-wrong-color=ff000099

key-hl-color=00ff99ee
bs-hl-color=ff4444ee

line-color=00000000
