#!/usr/bin/env bash

if (($# == 0)); then
  echo "Usage: my-launch-or-focus [app-id-pattern] [launch-command]"
  exit 1
fi

APP_PATTERN="$1"
LAUNCH_COMMAND="${2:-"$APP_PATTERN"}"

CLIENT_DATA=$(mmsg get all-clients 2>/dev/null)

WINDOW_ID=$(echo "$CLIENT_DATA" | jq -r --arg p "$APP_PATTERN" '
  (if type == "object" then .clients else . end) as $list |
  [$list[] | 
  select(
    (.appid // "" | ascii_downcase | contains($p | ascii_downcase))
  )] |
  sort_by(if .visible then 0 else 1 end) |
  .[0].id
')

if [[ -n "$WINDOW_ID" && "$WINDOW_ID" != "null" ]]; then
  mmsg dispatch focusid client,$WINDOW_ID
else
  setsid $LAUNCH_COMMAND >/dev/null 2>&1 &
fi
