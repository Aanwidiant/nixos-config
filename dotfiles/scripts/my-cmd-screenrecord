#!/usr/bin/env bash
set -e

MODE="${1:-fullscreen}"
AUDIO="${2:-desktop}"
FPS="${3:-60}"

SAVE_DIR="$HOME/Videos/Screenrecords"
mkdir -p "$SAVE_DIR"
TIMESTAMP=$(date +'%Y-%m-%d_%H-%M-%S')
FILENAME="$SAVE_DIR/recording_$TIMESTAMP.mkv"

case "$1" in
    stop)
        if pgrep -f "gpu-screen-recorder" > /dev/null; then
            pkill -SIGINT -f "gpu-screen-recorder" 
            notify-send "Recording Stopped & Saved"
            exit 0
        else
            notify-send "Tidak ada rekaman berjalan."
            exit 1
        fi
        ;;
    toggle-pause)
        if pgrep -f "gpu-screen-recorder" > /dev/null; then
            pkill -SIGUSR2 -f "gpu-screen-recorder" 
            notify-send "Recording Paused / Resumed"
            exit 0
        else
            notify-send "Tidak ada rekaman berjalan."
            exit 1
        fi
        ;;
esac

CMD_TARGET=()

case "$MODE" in
    region)
        RAW_GEOM=$(slurp 2>/dev/null)
        if [ -z "$RAW_GEOM" ]; then
            notify-send "Pemilihan region dibatalkan."
            exit 1
        fi

        REGION_FORMATTED=$(echo "$RAW_GEOM" | awk -F'[, ]' '{print $3"+"$1"+"$2}')
        CMD_TARGET=(-w region -region "$REGION_FORMATTED")
        ;;

    fullscreen)
        FOCUSED_MONITOR=$(mmsg get cursorpos 2>/dev/null | jq -r '.monitor // empty' 2>/dev/null || true)

        if [ -n "$FOCUSED_MONITOR" ] && [ "$FOCUSED_MONITOR" != "null" ]; then
            CMD_TARGET=(-w "$FOCUSED_MONITOR")
        else
            CMD_TARGET=(-w screen)
        fi
        ;;

    *)
        CMD_TARGET=(-w screen)
        ;;
esac

AUDIO_ARG=""
case "$AUDIO" in
    mic) AUDIO_ARG="default_input" ;;
    desktop) AUDIO_ARG="default_output" ;;
    combined|both) AUDIO_ARG="default_output|default_input" ;;
    none|*) AUDIO_ARG="" ;;
esac

notify-send "Recording Started"

CMD=(
    gpu-screen-recorder
    "${CMD_TARGET[@]}"
    -f "$FPS"
    -k h264
    -fm cfr
    -o "$FILENAME"
)

if [ -n "$AUDIO_ARG" ]; then
    CMD+=(-a "$AUDIO_ARG")
fi

exec "${CMD[@]}"
