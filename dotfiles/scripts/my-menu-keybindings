#!/usr/bin/env bash

# A script to display Niri keybindings defined in your configuration

parse_bindings() {
  niri msg action do-screen-transition 2>/dev/null || true
  niri msg bindings 2>/dev/null |
    awk '
    {
      line = $0
      # Parse "Mod+Key → action" format from niri msg bindings
      if (match(line, /^([^{]+)\{([^}]+)\}/, m)) {
        key_combo = m[1]
        action = m[2]

        # Clean up
        gsub(/^[ \t]+|[ \t]+$/, "", key_combo)
        gsub(/^[ \t]+|[ \t]+$/, "", action)
        gsub(/;$/, "", action)

        if (action != "") {
          printf "%-35s → %s\n", key_combo, action
        }
      }
    }'
}

# Fallback: parse langsung dari config files
parse_bindings_from_config() {
  local config_dir="$HOME/.config/niri/binds"
  [[ -d "$config_dir" ]] || config_dir="$HOME/.config/niri"

  grep -rh '^\s*\(Mod\|Alt\|Ctrl\|Shift\|XF86\)' "$config_dir"/*.kdl 2>/dev/null |
    awk -F'{' '
    {
      key_combo = $1
      action = $2

      gsub(/^[ \t]+|[ \t]+$/, "", key_combo)
      gsub(/^[ \t]+|[ \t]+$/, "", action)
      gsub(/[;}]/, "", action)
      gsub(/spawn /, "", action)

      if (key_combo != "" && action != "") {
        printf "%-35s → %s\n", key_combo, action
      }
    }'
}

prioritize_entries() {
  awk '
  {
    line = $0
    prio = 50
    if (match(line, /Terminal/))              prio = 0
    if (match(line, /Browser/) && !match(line, /Browser[[:space:]]*\(/)) prio = 1
    if (match(line, /File manager/))          prio = 2
    if (match(line, /Launch apps/))           prio = 3
    if (match(line, /My menu/))               prio = 4
    if (match(line, /System menu/))           prio = 5
    if (match(line, /fullscreen/))            prio = 7
    if (match(line, /close-window/))          prio = 8
    if (match(line, /toggle-window-floating/)) prio = 9
    if (match(line, /Universal/))             prio = 11
    if (match(line, /Clipboard/))             prio = 12
    if (match(line, /Emoji/))                 prio = 13
    if (match(line, /Color/))                 prio = 14
    if (match(line, /screenshot/))            prio = 15
    if (match(line, /screenrecord/))          prio = 16
    if (match(line, /focus-workspace/))       prio = 17
    if (match(line, /move-window-to-workspace/)) prio = 18
    if (match(line, /move-column/))           prio = 19
    if (match(line, /focus-column/))          prio = 20
    if (match(line, /set-column-width/))      prio = 22
    if (match(line, /set-window-height/))     prio = 23
    if (match(line, /toggle-window-rule-opacity/)) prio = 27
    if (match(line, /nightlight/))            prio = 29
    if (match(line, /XF86/))                  prio = 99

    printf "%d\t%s\n", prio, line
  }' |
  sort -k1,1n -k2,2 |
  cut -f2-
}

monitor_height=$(niri msg outputs 2>/dev/null | jq -r '.[] | select(.is_focused == true) | .current_mode.height' | head -n1)
menu_height=$(( ${monitor_height:-1080} * 40 / 100 ))

{
  parse_bindings_from_config
} |
  sort -u |
  prioritize_entries |
  my-launch-wofi --dmenu --prompt "Keybindings" --width 800 --height "$menu_height"
