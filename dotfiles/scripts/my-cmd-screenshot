#!/usr/bin/env bash
OUTPUT_DIR="$HOME/Pictures/Screenshots"
mkdir -p "$OUTPUT_DIR"
MODE="${1:-region}"
TIMESTAMP="$(date +'%Y-%m-%d_%H-%M-%S')"

FOCUSED_MONITOR=$(mmsg get cursorpos 2>/dev/null | jq -r '.monitor // empty' 2>/dev/null || true)

if [[ -z "$FOCUSED_MONITOR" || "$FOCUSED_MONITOR" == "null" ]]; then
    FOCUSED_MONITOR="eDP-1"
fi

case "$MODE" in
  fullscreen)
    sleep 0.2
    grim -o "$FOCUSED_MONITOR" - | \
      satty --filename - \
        --output-filename "$OUTPUT_DIR/screenshot-$TIMESTAMP.png" \
        --early-exit \
        --copy-command 'wl-copy'
    ;;
  region|*)
    sleep 0.2
    grim -g "$(slurp)" - | \
      satty --filename - \
        --output-filename "$OUTPUT_DIR/screenshot-$TIMESTAMP.png" \
        --early-exit \
        --copy-command 'wl-copy'
    ;;
esac
