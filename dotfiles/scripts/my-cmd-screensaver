#!/usr/bin/env bash

FILE="$HOME/.config/theme/screensaver.txt"
LOCKFILE="/tmp/screensaver.lock"

# prevent multiple instance
if [[ -f "$LOCKFILE" ]]; then
  exit 0
fi

touch "$LOCKFILE"
trap 'rm -f "$LOCKFILE"; pkill -x tte 2>/dev/null; exit' EXIT INT TERM

[[ -f "$FILE" ]] || exit 1

mapfile -t EFFECTS < <(
  tte --help | grep -A 100 "^effects:" | tail -n +2 | awk '{print $1}'
)

[[ ${#EFFECTS[@]} -eq 0 ]] && EFFECTS=(beams burn fireworks matrix rain slide spray waves binarypath blackhole bouncyballs bubbles colorshift crumble decrypt errorcorrect expand highlight laseretch middleout orbittingvolley overflow pour print rings randomsequence scattered slice slide smoke spotlights spray swarm sweep synthgrid thunderstorm unstable vhstape waves wipe)

printf '\033]11;rgb:00/00/00\007'
niri msg action set-cursor-visible false &>/dev/null || true

# single loop only
while true; do
  effect="${EFFECTS[RANDOM % ${#EFFECTS[@]}]}"

  tte \
  --input-file "$FILE" \
  --frame-rate 120 \
  --canvas-width 0 \
  --canvas-height 0 \
  --anchor-canvas c \
  --anchor-text c \
    "$effect" &

  tte_pid=$!

  while kill -0 "$tte_pid" 2>/dev/null; do
    if read -rsn1 -t 0.2; then
      kill "$tte_pid" 2>/dev/null
      exit 0
    fi
  done
done
