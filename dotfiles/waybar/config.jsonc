{
    "reload_style_on_change": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "height": 26,
    "margin-top": 4,
    "margin-left": 4,
    "margin-right": 4,
    "margin-bottom": 1,
    "modules-left": [
        "custom/nixos",
        "ext/workspaces"
    ],
    "modules-center": [
        "clock",
        "custom/screenrecording-indicator"
    ],
    "modules-right": [
        "cava",
        "bluetooth",
        "network",
        "pulseaudio",
        "cpu",
        "battery"
    ],
    "ext/workspaces": {
        "on-click": "activate",
        "ignore-hidden": true,
        "format": "{name}"
    },
    "custom/nixos": {
        "format": "<span font='CaskaydiaMono Nerd Font'>\uF313</span>",
        "on-click": "my-menu",
        "on-click-right": "xdg-terminal-exec"
    },
    "cpu": {
        "interval": 5,
        "format": "󰍛",
        "on-click": "my-launch-or-focus-tui btop"
    },
    "clock": {
        "format": "{:L%H:%M}",
        "format-alt": "{:L%A, %d %B %Y }",
        "tooltip": false,
        "on-click-right": "my-launch-or-focus-tui calcure"
    },
    "network": {
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "󰀂",
        "format-disconnected": "󰤮",
        "format-disabled": "󰤮",
        "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 3,
        "spacing": 1,
        "on-click": "my-launch-wifi",
        "on-click-right": "my-toggle-wifi"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-discharging": "{icon}",
        "format-charging": "{icon}",
        "format-plugged": "",
        "format-icons": {
            "charging": [
                "󰢜",
                "󰂆",
                "󰂇",
                "󰂈",
                "󰢝",
                "󰂉",
                "󰢞",
                "󰂊",
                "󰂋",
                "󰂅"
            ],
            "default": [
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ]
        },
        "format-full": "󰂅",
        "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
        "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
        "interval": 5,
        "on-click": "my-menu power",
        "states": {
            "warning": 20,
            "critical": 10
        }
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-connected": "󰂱",
        "format-no-controller": "",
        "tooltip-format": "Devices connected: {num_connections}",
        "on-click": "my-launch-bluetooth",
        "on-click-right": "my-toggle-bluetooth"
    },
    "pulseaudio": {
        "format": "{icon}",
        "on-click": "my-launch-or-focus-tui wiremix",
        "on-click-right": "pamixer -t",
        "tooltip-format": "Playing at {volume}%",
        "scroll-step": 5,
        "format-muted": "",
        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        }
    },
    "custom/screenrecording-indicator": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.config/waybar/indicators/screen-recording.sh",
        "on-click": "pkill -INT wf-recorder && pkill -RTMIN+8 waybar",
        "signal": 8,
        "interval": 2
    },
    "cava": {
        "framerate": 30,
        "autosens": 1,
        "bars": 16,
        "method": "pipewire",
        "source": "auto",
        "bar_delimiter": 0,
        "monstercat": false,
        "waves": false,
        "noise_reduction": 0.3,
        "input_delay": 2,
        "sleep_timer": 2,
        "hide_on_silence": true,
        "format-icons": [
            " ",
            "▁",
            "▂",
            "▃",
            "▄",
            "▅",
            "▆",
            "▇",
            "█"
        ]
        // "format-icons": [" ", "⣀", "⣄", "⣤", "⣦", "⣶", "⣷", "⣿"]
    }
}
